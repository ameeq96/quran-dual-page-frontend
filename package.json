    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.5.4",
    "typeorm": "^0.3.20",
    "vite": "^5.4.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
