{
  "name": "quran-admin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:server && node -e \"const fs=require('fs');fs.copyFileSync('public/.htaccess','dist/.htaccess');\"",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node server.js",
    "postinstall": "npm run build"
  },
